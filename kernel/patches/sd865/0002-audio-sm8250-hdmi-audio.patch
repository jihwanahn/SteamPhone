From: SteamPhone Project <steamphone@example.com>
Subject: [PATCH 2/2] arm64: dts: qcom: Enable HDMI/USB-C audio for SM8250
Date: Mon, 1 Jan 2024 00:00:00 +0000
Signed-off-by: SteamPhone Project <steamphone@example.com>
---

Enable HDMI and USB-C audio for SM8250.

Note: This is a STUB patch. Audio configuration needs verification.

diff --git a/arch/arm64/boot/dts/qcom/sm8250-audio.dtsi b/arch/arm64/boot/dts/qcom/sm8250-audio.dtsi
new file mode 100644
index 0000000..4567890
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8250-audio.dtsi
@@ -0,0 +1,15 @@
+/*
+ * SM8250 Audio configuration for SteamPhone
+ * Enables USB-C and HDMI audio outputs
+ */
+
+&sound {
+	/* USB-C audio class support */
+	usb-c-audio {
+		compatible = "usb-audio";
+		type = "usb-c";
+	};
+
+	/* HDMI audio */
+	hdmi-audio {
+		compatible = "hdmi-audio";
+	};
+};
