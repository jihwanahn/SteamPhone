{
  "version": 1,
  "name": "SteamPhone Default Layout",
  "description": "Touch regions for SteamPhone in portrait mode",
  
  "display": {
    "width": 1080,
    "height": 2400,
    "orientation": "portrait",
    "dpi": 407
  },

  "touch_regions": [
    {
      "id": "L2",
      "name": "Left Trigger",
      "x": 0, "y": 0,
      "w": 270, "h": 600,
      "type": "trigger",
      "axis": "lt",
      "multiplier": 1.0
    },
    {
      "id": "L1",
      "name": "Left Shoulder",
      "x": 0, "y": 600,
      "w": 270, "h": 300,
      "type": "shoulder",
      "button": "tl"
    },
    {
      "id": "DPAD_UP",
      "name": "D-Pad Up",
      "x": 80, "y": 1200,
      "w": 110, "h": 110,
      "type": "button",
      "button": "up"
    },
    {
      "id": "DPAD_DOWN",
      "name": "D-Pad Down",
      "x": 80, "y": 1520,
      "w": 110, "h": 110,
      "type": "button",
      "button": "down"
    },
    {
      "id": "DPAD_LEFT",
